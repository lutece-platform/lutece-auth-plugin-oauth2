        <property name="dataServerUri" value="${oauth2.dataclient.logUserInfo.dataServerUri}"/>
        <property name="tokenMethod" value="${oauth2.dataclient.logUserInfo.tokenMethod}"/>
        <property name="scope" value="#{'${oauth2.dataclient.logUserInfo.scopes}'.split('\s*,\s*')}"/>
        <!- - Optional eIDAS management - ->
        <!- -
        <property name="acrValuesSet" value="#{'${oauth2.dataclient.logUserInfo.acrValues}'.split('\s*,\s*')}"/>
        - ->
    </bean>
    -->

    <bean id="oauth2.jwtParser" class="fr.paris.lutece.plugins.oauth2.jwt.JjwtJWTParser" />
        
</beans>
